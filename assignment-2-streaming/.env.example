# Copy to .env to override docker-compose defaults.

# TimescaleDB (host port 15433 to avoid clashing with a local PostgreSQL)
POSTGRES_DB=taxi_stream
POSTGRES_USER=taxi
POSTGRES_PASSWORD=taxi
TIMESCALE_PORT=15433

# Producer: file under ../data/raw, rate profile (constant|wave) and disorder simulation
PRODUCER_SOURCE_FILE_NAME=yellow_tripdata_2023-01.parquet
PRODUCER_RATE_PROFILE=wave
PRODUCER_MIN_RATE=10
PRODUCER_MAX_RATE=50
PRODUCER_OUT_OF_ORDER_RATIO=0.05
PRODUCER_MAX_DELAY_SECONDS=30

# Stream processor: sliding window (size / slide) and allowed lateness, in event-time seconds
WINDOW_SIZE_SECONDS=900
WINDOW_SLIDE_SECONDS=300
ALLOWED_LATENESS_SECONDS=600

GRAFANA_ADMIN_PASSWORD=admin

# Host ports (non-standard defaults to avoid clashing with locally installed services)
GRAFANA_PORT=3300
KAFKA_UI_PORT=8088
