# --- PostgreSQL (docker-compose.yml reads the same variables) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=taxi_dw
POSTGRES_USER=taxi
POSTGRES_PASSWORD=taxi

# --- Pipeline ---
# Comma separated list of YYYY-MM months processed by default.
ETL_MONTHS=2023-01,2023-02
# Optional cap on rows read per month (handy for quick demos). Empty = all rows.
ETL_MAX_ROWS_PER_MONTH=
ETL_LOAD_CHUNK_SIZE=250000
LOG_LEVEL=INFO

# --- Sources ---
TRIP_DATA_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
ZONE_LOOKUP_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv

# --- Alerting ---
# Optional Slack/Teams-compatible incoming webhook. Failures are always written to logs/alerts.jsonl.
ALERT_WEBHOOK_URL=

# --- Prefect ---
# Forward the pipeline's own logger to the Prefect UI.
PREFECT_LOGGING_EXTRA_LOGGERS=taxi_etl
# Uncomment after `prefect server start` to see runs in the UI at http://127.0.0.1:4200
# PREFECT_API_URL=http://127.0.0.1:4200/api
